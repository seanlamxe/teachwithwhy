# Local development only. Never commit actual credentials.
# auto chooses an explicitly configured DeepSeek/OpenAI key, otherwise Vercel AI Gateway.
AI_PROVIDER=auto
AI_ENABLED=true
AI_GATEWAY_MODEL=deepseek/deepseek-v4.1-flash-1017
# Vercel project identity (OIDC) can authenticate without an API key.
# An owner-supplied key is optional for non-Vercel hosts or local development.
AI_GATEWAY_API_KEY=
# Gateway live mode fetches the fixed, reviewed EEF pages. Direct providers use search.
AI_LIVE_SEARCH=true
AI_MAX_REQUESTS_PER_HOUR=5
AI_MAX_TOTAL_REQUESTS_PER_HOUR=60
# Optional direct connections; teachers never need to enter these.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
