# Copy to .env.local for local development. Never commit real secrets.
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# Official latest Flash alias checked 2026-11-03: DeepSeek-V4.1-Flash-1017.
# For the Pro model use deepseek-v4-pro. Availability is account-dependent.
DEEPSEEK_MODEL=deepseek-flash
# A private pilot access code, at least 12 characters. Share only with your testers.
APP_ACCESS_CODE=
AI_LIVE_SEARCH=true
AI_MAX_REQUESTS_PER_HOUR=20
# Optional GPT alternative. No automatic cross-provider failover.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
